#!/bin/sh
# Runs vpsctl in a container, so the VPS needs only docker and git.
#
# The docker socket is mounted because vpsctl's whole job is driving docker:
# resolving upstreams on the network, running the nginx validator, reloading the
# proxy.
#
# THAT MOUNT IS ROOT-EQUIVALENT ON THE HOST. Anyone who can run this script can
# run any container, including one that mounts /. Restrict it accordingly.
set -eu

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="ghcr.io/dangkhoaddk/vps-configuration:latest"
ENV_FILE="$REPO_DIR/stack/.env"
ENV_EXAMPLE="$REPO_DIR/stack/.env.example"

if [ ! -f "$ENV_FILE" ]; then
  if [ ! -f "$ENV_EXAMPLE" ]; then
    echo "$ENV_FILE is missing, and $ENV_EXAMPLE does not exist to copy from." >&2
    exit 1
  fi
  echo "$ENV_FILE is missing. Creating it from stack/.env.example." >&2
  cp "$ENV_EXAMPLE" "$ENV_FILE"
fi

# shellcheck disable=SC1090
set -a; . "$ENV_FILE"; set +a

# The CLI reads and writes these host directories. They are mounted at their own
# paths so nothing has to be translated: a path means the same thing inside the
# container and out.
#
# They must already exist. Docker creates a missing bind-mount source as an empty
# directory rather than failing, and an empty nginx config directory is a proxy
# that starts and serves nothing.
for dir in "$NGINX_CONF_DIR" "$SNIPPETS_DIR" "$CERTS_ROOT"; do
  if [ ! -d "$dir" ]; then
    echo "Directory does not exist: $dir" >&2
    echo "  Create it, or fix the path in $ENV_FILE." >&2
    echo "  Docker would otherwise create it empty, leaving nginx serving nothing." >&2
    exit 1
  fi
done

# Built and pushed to GHCR in CI. Pulled fresh on every run so a deploy always
# gets the version that last passed CI.
#
# A failed pull is not fatal when an image is already cached: a network blip
# should not take down a deploy. But it must be LOUD, because what it otherwise
# hides is the exact failure this repo exists to prevent - a VPS running a stale
# vpsctl against a current apps.yml, reporting success the whole way.
#
# The pull failing is not hypothetical. Each app's pipeline logs in to GHCR with
# its own repository's GITHUB_TOKEN, which has no read access to this package, so
# it 403s on every app deploy. That is a package-permission fix, not a shell one;
# this only makes sure it cannot happen quietly.
if pull_error="$(docker pull -q "$IMAGE" 2>&1 >/dev/null)"; then
  :
elif cached_at="$(docker image inspect "$IMAGE" --format '{{.Created}}' 2>/dev/null)"; then
  echo "!! Could not pull $IMAGE" >&2
  echo "!!   $pull_error" >&2
  echo "!! Falling back to the locally cached image, built $cached_at." >&2
  echo "!! That image may be older than apps.yml. If routing looks wrong, this is why." >&2
else
  echo "Could not pull $IMAGE, and no cached copy exists to fall back to." >&2
  echo "  $pull_error" >&2
  echo "  Authenticate first: echo \$TOKEN | docker login ghcr.io -u <user> --password-stdin" >&2
  exit 1
fi

# VPSCTL_HOST_REPO_DIR lets the containerised CLI translate its own scratch paths
# back to host paths when it builds bind-mount sources for other containers.
#
# VPSCTL_REPO_ROOT points the compiled code at the live checkout mounted at
# /repo, since the image bakes dist/ and node_modules into /app instead (a
# bind mount at /repo would otherwise hide whatever the image put there).
exec docker run --rm -i \
  -v "$REPO_DIR":/repo \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v "$NGINX_CONF_DIR":"$NGINX_CONF_DIR" \
  -v "$SNIPPETS_DIR":"$SNIPPETS_DIR" \
  -v "$CERTS_ROOT":"$CERTS_ROOT" \
  -e VPSCTL_HOST_REPO_DIR="$REPO_DIR" \
  -e VPSCTL_REPO_ROOT=/repo \
  -w /repo \
  "$IMAGE" "$@"
