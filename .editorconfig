root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# nginx config and templates: keep them readable as nginx, 4-space is the
# convention in the config this repo reproduces.
[*.{conf,hbs}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
